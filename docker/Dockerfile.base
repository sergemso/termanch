# Runtime base for the termanch-server image. Rebuilt weekly and on change (.github/workflows/base-image.yaml);
# the app image only adds the server binary on top, so a code change never reinstalls these packages.
# Node is here so coding agents (codex, claude) can be installed inside the session environment.
FROM node:22-bookworm-slim
LABEL org.opencontainers.image.source="https://github.com/sergemso/termanch" \
      org.opencontainers.image.description="Termanch runtime base: node, tmux, git, curl, ssh" \
      org.opencontainers.image.licenses="MIT"
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tmux git curl openssh-client procps \
    && rm -rf /var/lib/apt/lists/*
