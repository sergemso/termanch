# Display name
SERVER_NAME=my-vps

# Self-hosted client only (default: https://app.termanch.dev)
# TERMANCH_CLIENT_URL=https://app.example.com

# Cloudflare Tunnel token (create at https://dash.cloudflare.com/access/tunnels)
# Or use docker-compose.trycloudflare.yml for quick testing (no account needed)
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token
